            "url": {
              "raw": "http://localhost:8083/.well-known/openid-configuration",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8083",
              "path": [".well-known", "openid-configuration"]
            }
          }
        },
        {
          "name": "JWK Set",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8083/oauth2/jwks",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8083",
              "path": ["oauth2", "jwks"]
            }
          }
        }
      ]
    },
    {
